{
  "name": "driftreplay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "11.25.0"
  },
  "scripts": {
    "dev": "corepack pnpm --filter @driftreplay/web dev",
    "typecheck": "corepack pnpm -r typecheck && tsc -p tsconfig.tests.json --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:fixtures": "vitest run tests/fixtures",
    "test:analysis": "vitest run packages/analysis tests/integration tests/security tests/golden",
    "analyze:fixture": "node packages/analysis/src/cli.ts --fixture",
    "build": "corepack pnpm --filter @driftreplay/web build",
    "smoke": "node scripts/smoke.mjs",
    "preview": "node scripts/preview.mjs",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm format:check && corepack pnpm test && corepack pnpm test:fixtures && corepack pnpm test:analysis && corepack pnpm test:durable && corepack pnpm analyze:fixture && corepack pnpm build && corepack pnpm smoke",
    "durable:doctor": "node packages/durable/src/cli.ts doctor",
    "durable:migrate": "node packages/durable/src/cli.ts migrate",
    "durable:submit": "node packages/durable/src/cli.ts submit",
    "durable:worker": "node packages/durable/src/cli.ts worker",
    "durable:list": "node packages/durable/src/cli.ts list",
    "durable:status": "node packages/durable/src/cli.ts status",
    "durable:events": "node packages/durable/src/cli.ts events",
    "durable:cancel": "node packages/durable/src/cli.ts cancel",
    "durable:verify": "node packages/durable/src/cli.ts verify",
    "durable:reconcile": "node packages/durable/src/cli.ts reconcile",
    "durable:gc": "node packages/durable/src/cli.ts gc",
    "test:durable": "vitest run packages/durable tests/durable"
  },
  "devDependencies": {
    "@driftreplay/core": "workspace:0.1.0",
    "@driftreplay/demo-shop": "workspace:0.1.0",
    "@driftreplay/fixtures": "workspace:0.1.0",
    "@types/node": "24.10.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
